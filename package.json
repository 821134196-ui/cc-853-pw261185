{
  "name": "postgres-lock-diagnostic-bench",
  "version": "1.0.0",
  "private": true,
  "description": "Reproducible PostgreSQL blocking and deadlock diagnostic workbench",
  "main": "server/server.js",
  "scripts": {
    "setup": "bash scripts/setup-local-postgres.sh",
    "db:start": "bash scripts/start-local-postgres.sh",
